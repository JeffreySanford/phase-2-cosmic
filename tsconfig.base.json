{
  "compileOnSave": false,
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "rootDir": "./",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ES2022",
    "typeRoots": ["./node_modules/@types", "./node_modules/cypress/types"],
    "lib": ["ES2022", "DOM"]
  }
}
