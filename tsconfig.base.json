{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "ui-theme": ["libs/ui-theme/src/index.ts"]
    },
    "rootDir": "./",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"]
  }
}
