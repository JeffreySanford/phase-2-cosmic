{
  "name": "lakehouse-mvp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tools/lakehouse-mvp",
  "targets": {
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/run-python.cjs tools/lakehouse-mvp/pr41_lakehouse_mvp.py"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/lakehouse-mvp/verify-pr41-mvp.mjs"
      }
    },
    "validate-source-registry": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/lakehouse-mvp/validate-source-registry.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node tools/lakehouse-mvp/validate-source-registry.mjs",
          "node scripts/run-python.cjs tools/lakehouse-mvp/test_pr41_lakehouse_mvp.py",
          "node scripts/run-python.cjs tools/lakehouse-mvp/pr41_lakehouse_mvp.py",
          "node tools/lakehouse-mvp/verify-pr41-mvp.mjs --require-fresh"
        ],
        "parallel": false
      }
    }
  }
}
