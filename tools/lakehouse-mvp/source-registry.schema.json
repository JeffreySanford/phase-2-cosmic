{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phase-2-cosmic.local/schemas/lakehouse-pr41-source-registry.json",
  "title": "PR41 Lakehouse Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultBundle",
    "adapterContract",
    "selectionPolicy",
    "profiles",
    "bundles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "lakehouse-source-registry.v1"
    },
    "defaultBundle": {
      "type": "string",
      "minLength": 1
    },
    "adapterContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonicalFields"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "canonicalFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "sourceIdentifier",
              "collection",
              "dataProductType",
              "ra",
              "dec",
              "accessUri"
            ]
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeStates", "inactiveStates", "precedence"],
      "properties": {
        "activeStates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["included", "fixture"]
          },
          "uniqueItems": true
        },
        "inactiveStates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["excluded", "planned"]
          },
          "uniqueItems": true
        },
        "precedence": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": ["fixture", "included", "planned", "excluded"]
          },
          "uniqueItems": true
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "bundles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/bundle"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "provider",
        "kind",
        "activationState",
        "includeByDefault",
        "evidenceRole"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["vo-tap", "fixture", "planned"]
        },
        "activationState": {
          "type": "string",
          "enum": ["included", "excluded", "planned", "fixture"]
        },
        "includeByDefault": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "evidenceRole": {
          "type": "string",
          "enum": ["public-proof", "offline-fixture", "development-candidate"]
        },
        "adapter": {
          "$ref": "#/$defs/adapter"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "fixturePath", "fieldMap"],
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "fixturePath": {
          "type": "string",
          "minLength": 1
        },
        "fieldMap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIdentifier",
            "collection",
            "dataProductType",
            "ra",
            "dec",
            "accessUri"
          ],
          "properties": {
            "sourceIdentifier": { "type": "string", "minLength": 1 },
            "collection": { "type": "string", "minLength": 1 },
            "dataProductType": { "type": "string", "minLength": 1 },
            "ra": { "type": "string", "minLength": 1 },
            "dec": { "type": "string", "minLength": 1 },
            "accessUri": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "profileRefs", "intendedUse"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "profileRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "intendedUse": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
