{
  "name": "maven-test-image",
  "root": "tools/maven-test-image",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker build -t phase2/maven-test:17 tools/maven-test-image"
        ],
        "cwd": "./"
      }
    },
    "push": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["docker push phase2/maven-test:17"],
        "cwd": "./"
      }
    }
  }
}
