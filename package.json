    "@angular/language-service": "21.2.3",
    "@angular/localize": "^21.2.6",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@esbuild/win32-x64": "0.27.4",
    "@eslint/js": "^9.8.0",
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "@nrwl/angular": "19.8.4",
    "@nrwl/workspace": "^19.8.4",
    "@nx/cypress": "22.5.4",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/jest": "22.5.4",
    "@nx/js": "22.5.4",
    "@nx/nx-win32-x64-msvc": "22.5.4",
    "@nx/web": "22.5.4",
    "@playwright/test": "^1.58.2",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0",
    "@schematics/angular": "~21.2.2",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/dockerode": "^3.3.2",
    "@types/express": "4.17.14",
    "@types/jest": "^29.5.12",
    "@types/node": "20.19.0",
    "@typescript-eslint/utils": "^8.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "angular-eslint": "^21.3.0",
    "cross-env": "^7.0.3",
    "cypress": "15.8.0",
    "dockerode": "^3.3.2",
    "esbuild": "^0.27.4",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^3.5.0",
    "express": "^4.20.0",
    "is-unicode-supported": "0.1.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^16.1.1",
    "markdown-link-check": "^3.14.2",
    "markdownlint-cli": "^0.47.0",
    "nx": "22.5.4",
    "playwright": "^1.58.2",
    "prettier": "^2.6.2",
    "reflect-metadata": "^0.2.2",
    "source-map": "0.6.1",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^4.2.0"
  },
  "dependenciesMeta": {},
  "dependencies": {
    "@angular/animations": "21.2.3",
    "@angular/cdk": "21.2.2",
    "@angular/common": "21.2.3",
    "@angular/compiler": "21.2.3",
    "@angular/core": "21.2.3",
    "@angular/forms": "21.2.3",
    "@angular/material": "21.2.2",
    "@angular/platform-browser": "21.2.3",
    "@angular/platform-browser-dynamic": "21.2.3",
    "@angular/platform-server": "21.2.13",
    "@angular/router": "21.2.3",
    "@angular/ssr": "21.2.2",
    "@ngrx/effects": "^21.1.0",
    "@ngrx/entity": "^21.1.0",
    "@ngrx/store": "^21.1.0",
    "@ngrx/store-devtools": "^21.1.0",
    "aladin-lite": "^3.7.3-beta",
    "concurrently": "^9.2.1",
    "d3": "^7.9.0",
    "graphql": "^16.13.2",
    "redis": "^4.6.7",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express>multer": "^2.1.1",
      "esbuild": "0.27.4",
      "@esbuild/*": "0.27.4"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@swc/core",
      "cpu-features",
      "cypress",
      "esbuild",
      "lmdb",
