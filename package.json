{
  "name": "phase-2-cosmic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:all": "sh ./scripts/start-all.sh",
    "serve:ssr": "pnpm exec ts-node --project apps/frontend/tsconfig.server.json apps/frontend/server.nest.ts",
    "start:all:reset": "node ./tools/run-with-logs.js \"sh ./scripts/start-all-reset.sh\" start-all-reset",
    "lint": "pnpm nx run-many --target=lint --all && pnpm run lint:docker && pnpm run lint:yaml",
    "lint:docker": "node ./scripts/hadolint-runner.js",
    "lint:yaml": "node ./scripts/yamllint-runner.js",
    "format:check:changed": "pnpm exec prettier --check \"**/*.{ts,tsx,js,jsx,json,md,scss,yml,yaml}\"",
    "test:libs": "pnpm nx run ui-theme:test",
    "docker:test-runner": "cross-env PNPM_STORE_DIR=./pnpm-store sh -c \"corepack enable || true; corepack prepare pnpm@latest --activate || true; mkdir -p $PNPM_STORE_DIR && pnpm install --frozen-lockfile --store-dir=$PNPM_STORE_DIR --ignore-scripts && (git rev-parse --verify origin/main >/dev/null 2>&1 && pnpm nx affected --target=test --base=origin/main --parallel=false || pnpm nx run-many --target=test --all --parallel=false) && mvn -f apps/java-governance/pom.xml clean verify -Pwith-containers && pnpm run e2e-smoke\"",
    "openapi-validate": "node tools/validate-openapi.mjs",
    "unit-test": "pnpm nx run-many --target=test --all --configuration=ci --parallel=false",
    "unit-test:coverage": "pnpm nx run-many --target=test --all --configuration=ci --codeCoverage --parallel=false",
    "e2e-smoke": "pnpm nx run frontend-e2e:e2e-ci",
    "quality:ci": "pnpm run lint && pnpm run format:check:changed && pnpm run unit-test && pnpm run openapi-validate && pnpm run docs:validate && pnpm run e2e-smoke",
    "playwright:install": "pnpm exec playwright install --with-deps",
    "docs:validate": "bash scripts/check-docs.sh",
    "e2e:playwright": "pnpm exec playwright test --config=tools/playwright/playwright.config.ts --reporter=html",
    "coverage:check": "bash scripts/check-coverage.sh 90"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~18.2.0",
    "@angular-devkit/core": "~18.2.0",
    "@angular-devkit/schematics": "~18.2.0",
    "@angular-eslint/eslint-plugin-template": "^21.2.0",
    "@angular-eslint/template-parser": "^21.2.0",
    "@angular/cli": "~18.2.0",
    "@angular/compiler-cli": "~18.2.0",
    "@angular/language-service": "~18.2.0",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "@nrwl/angular": "^19.8.4",
    "@nx/cypress": "19.8.4",
    "@nx/eslint": "19.8.4",
    "@nx/eslint-plugin": "19.8.4",
    "@nx/jest": "19.8.4",
    "@nx/js": "19.8.4",
    "@nx/web": "19.8.4",
    "@playwright/test": "^1.58.2",
    "@schematics/angular": "~18.2.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/express": "4.17.14",
    "@types/jest": "^29.5.12",
    "@types/node": "20.19.0",
    "@typescript-eslint/utils": "^8.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "angular-eslint": "^18.3.0",
    "concurrently": "^8.0.1",
    "cross-env": "^7.0.3",
    "cypress": "^13.13.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-cypress": "^3.5.0",
    "express": "~4.18.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "~14.1.0",
    "markdownlint-cli": "^0.47.0",
    "markdown-link-check": "^3.14.2",
    "nx": "22.5.2",
    "playwright": "^1.58.2",
    "prettier": "^2.6.2",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typescript": "~5.5.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^4.2.0"
  },
  "dependenciesMeta": {},
  "dependencies": {
    "@angular/animations": "~18.2.0",
    "@angular/cdk": "~18.2.0",
    "@angular/common": "~18.2.0",
    "@angular/compiler": "~18.2.0",
    "@angular/core": "~18.2.0",
    "@angular/forms": "~18.2.0",
    "@angular/material": "~18.2.0",
    "@angular/platform-browser": "~18.2.0",
    "@angular/platform-browser-dynamic": "~18.2.0",
    "@angular/platform-server": "~18.2.0",
    "@angular/router": "~18.2.0",
    "@angular/ssr": "~18.2.0",
    "aladin-lite": "^3.7.3-beta",
    "d3": "^7.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "packageManager": "pnpm@10.23.0"
}
