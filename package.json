{
  "name": "phase-2-cosmic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "nx-no-cloud": "node ./scripts/run-nx-no-cloud.cjs",
    "start:all": "sh ./scripts/start-all.sh",
    "serve:ssr": "node ./node_modules/tsx/dist/cli.mjs --watch --tsconfig apps/frontend/tsconfig.server.json apps/frontend/server.nest.ts",
    "serve:ssr:e2e": "node ./node_modules/tsx/dist/cli.mjs --tsconfig apps/frontend/tsconfig.server.json apps/frontend/server.nest.ts",
    "start:all:reset": "node ./tools/run-with-logs.js \"sh ./scripts/start-all-reset.sh\" start-all-reset",
    "lint": "node ./scripts/run-nx-no-cloud.cjs run-many --target=lint --projects=frontend-e2e,frontend,ui-theme --parallel=false && pnpm run lint:docker && pnpm run lint:yaml && pnpm run format:fix",
    "lint:docker": "node ./scripts/hadolint-runner.js",
    "lint:yaml": "node ./scripts/yamllint-runner.js",
    "lint:go": "sh ./scripts/lint-go.sh",
    "lint:browser-globals": "node ./scripts/check-browser-globals.js",
    "lint:python": "sh ./scripts/lint-python.sh",
    "format:fix": "node ./node_modules/prettier/bin-prettier.js --write \"**/*.{ts,tsx,js,jsx,json,md,scss,yml,yaml}\"",
    "format:check:changed": "node ./node_modules/prettier/bin-prettier.js --check \"**/*.{ts,tsx,js,jsx,json,md,scss,yml,yaml}\"",
    "test:libs": "pnpm nx run ui-theme:test",
    "test:go": "sh ./scripts/test-go.sh",
    "test:java:governance": "node ./scripts/mvn-wrapper-runner.js --use-compose -f apps/java-governance/pom.xml clean verify -B",
    "test:java:governance:it": "node ./scripts/mvn-wrapper-runner.js --use-compose -f apps/java-governance/pom.xml clean verify -Pwith-containers -B -Dsurefire.skipAfterFailureCount=3 -Dfailsafe.skipAfterFailureCount=3",
    "test:java:ingest": "node ./scripts/mvn-wrapper-runner.js --use-compose -f tools/java-ingest/pom.xml clean verify -B",
    "test:java:ingest:it": "node ./scripts/mvn-wrapper-runner.js --use-compose -f tools/java-ingest/pom.xml clean verify -Pwith-containers -B",
    "test:java": "pnpm run test:java:governance && pnpm run test:java:ingest",
    "test:java:it": "pnpm run test:java:governance:it && pnpm run test:java:ingest:it",
    "docker:test-runner": "sh ./scripts/docker-test-runner.sh",
    "openapi-validate": "node tools/validate-openapi.mjs",
    "test:trident-allocator": "node ./scripts/run-jest.cjs --config tools/trident-allocator/jest.config.cjs --no-coverage",
    "unit-test": "node ./scripts/run-nx-no-cloud.cjs run-many --target=test --all --configuration=ci --parallel=false",
    "unit-test:coverage": "node ./scripts/run-nx-no-cloud.cjs run-many --target=test --all --configuration=ci --parallel=false",
    "coverage:clean": "node -e \"require('fs').rmSync('coverage', { recursive: true, force: true })\"",
    "e2e": "node ./scripts/run-nx-no-cloud.cjs run frontend-e2e:e2e",
    "e2e:ci": "node ./scripts/run-nx-no-cloud.cjs run frontend-e2e:e2e-ci",
    "e2e-smoke": "node ./scripts/run-nx-no-cloud.cjs run frontend-e2e:e2e-ci",
    "analyze:semgrep": "sh ./scripts/lint-semgrep.sh",
    "ci:logs": "sh ./scripts/ci-logs.sh",
    "ci:logs:list": "sh ./scripts/ci-logs.sh --list",
    "ci:logs:watch": "sh ./scripts/ci-logs.sh --watch",
    "ci:codeql": "sh ./scripts/ci-codeql.sh",
    "ci:codeql:list": "sh ./scripts/ci-codeql.sh --list",
    "ci:codeql:trigger": "sh ./scripts/ci-codeql.sh --trigger",
    "quality:ci": "pnpm run lint && pnpm run lint:go && pnpm run format:check:changed && pnpm run coverage:clean && pnpm run unit-test:coverage && pnpm run ci:integration && pnpm run test:java && pnpm run test:go && pnpm run openapi-validate && pnpm run docs:validate && pnpm run coverage:check && pnpm run e2e-smoke",
    "test:all": "pnpm run quality:ci && pnpm run test:java:it && pnpm run analyze:semgrep",
    "playwright:install": "pnpm exec playwright install --with-deps",
    "docs:validate": "bash scripts/check-docs.sh",
    "validate:load": "node scripts/validate-100pct-load.js",
    "validate:stress": "bash scripts/check-stress-containers.sh",
    "validate:ci:stress": "bash scripts/ci-validate-stress.sh",
    "e2e:playwright": "pnpm exec playwright test --config=tools/playwright/playwright.config.ts --reporter=html",
    "ci:integration": "pnpm run test:trident-allocator && pnpm run test:java:governance:it",
    "coverage:check": "bash scripts/check-coverage.sh 90"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.2",
    "@angular-devkit/core": "~21.2.2",
    "@angular-devkit/schematics": "~21.2.2",
