## Example environment for local demos. Copy to .env and fill in private values.
DOCKER_USERNAME=your-docker-username
DOCKER_PAT=replace_with_personal_access_token
# GitHub PAT with read:packages scope - used to pull images from ghcr.io
GITHUB_USERNAME=your-github-username
GITHUB_PAT=replace_with_github_pat_with_read_packages_scope
# Sample environment file with only secret placeholders.
# Non-secret configuration is supplied by the frontend `EnvironmentComponent`.
# Copy this file to `.env` and set secret values (do NOT commit `.env`).

# Secrets
MINIO_ROOT_PASSWORD=changeme

# Host port overrides to avoid collisions when running compose locally.
# Map Kafka host listener (container port 9093) to a host port. Default is 9094
# to avoid common conflicts with Alertmanager which uses 9093.
KAFKA_HOST_PORT=9094
