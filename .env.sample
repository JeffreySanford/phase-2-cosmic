## Example environment for local development and demos.
#
# Precedence:
#   1. `.env` is the local/private override and is gitignored.
#   2. `.env.sample` provides committed development defaults when `.env` is absent.
#
# Keep password/credential values centralized in `.env*` files rather than
# embedding them in Docker Compose files. Copy this file to `.env` and replace
# the development values before using anything beyond local development.

# Optional registry credentials. Placeholder values are intentionally ignored
# by the startup scripts until replaced in a private `.env`.
DOCKER_USERNAME=your-docker-username
DOCKER_PAT=
GITHUB_USERNAME=your-github-username
GITHUB_PAT=

# MinIO local-development credentials.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL_DEV_MINIO_2026

# Cosmic Forge Postgres local-development credentials.
FORGE_POSTGRES_DB=cosmic_forge
FORGE_POSTGRES_USER=cosmic_forge
FORGE_POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_POSTGRES_2026

# Host port overrides to avoid collisions when running compose locally.
# Map Kafka host listener (container port 9093) to a host port. Default is 9094
# to avoid common conflicts with Alertmanager which uses 9093.
KAFKA_HOST_PORT=9094

PULSAR_CLUSTER_NAME=pulsar-cluster
