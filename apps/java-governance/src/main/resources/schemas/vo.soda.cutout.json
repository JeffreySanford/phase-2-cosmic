{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vo.soda.cutout parameters",
  "type": "object",
  "required": ["provider", "sodaUrl", "datasetIdentifier"],
  "properties": {
    "provider": { "type": "string", "minLength": 1 },
    "sodaUrl": { "type": "string", "minLength": 1 },
    "datasetIdentifier": { "type": "string", "minLength": 1 },
    "spatialBoundsRa": { "type": "number" },
    "spatialBoundsDec": { "type": "number" },
    "spatialBoundsRadius": { "type": "number", "exclusiveMinimum": 0 },
    "outputFormat": { "type": "string" },
    "liveMode": { "type": "boolean" }
  },
  "additionalProperties": true
}
