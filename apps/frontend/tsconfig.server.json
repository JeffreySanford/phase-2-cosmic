{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "outDir": "../../dist/apps/frontend/server",
    "types": ["node"]
  },
  "include": ["server.nest.ts", "src/**/*.ts"]
}
