{
  "name": "cosmic-forge-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cosmic-forge-api/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/cosmic-forge-api"],
      "options": {
        "command": "pnpm exec tsc -p apps/cosmic-forge-api/tsconfig.app.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./node_modules/tsx/dist/cli.mjs watch --tsconfig apps/cosmic-forge-api/tsconfig.app.json apps/cosmic-forge-api/src/main.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./node_modules/tsx/dist/cli.mjs --tsconfig apps/cosmic-forge-api/tsconfig.app.json --test apps/cosmic-forge-api/src/state/forge-store.service.spec.ts apps/cosmic-forge-api/src/graphql/forge-graphql.service.spec.ts apps/cosmic-forge-api/src/services/forge-target-resolver.service.spec.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/cosmic-forge-api/src/**/*.ts"]
      }
    }
  }
}
