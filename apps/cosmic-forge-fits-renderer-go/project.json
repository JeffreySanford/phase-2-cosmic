{
  "name": "cosmic-forge-fits-renderer-go",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cosmic-forge-fits-renderer-go",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/cosmic-forge-fits-renderer-go"],
      "options": {
        "command": "powershell -NoProfile -Command \"Set-Location 'apps/cosmic-forge-fits-renderer-go'; go build -o '..\\\\..\\\\dist\\\\apps\\\\cosmic-forge-fits-renderer-go\\\\fits-renderer.exe' .\""
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "powershell -NoProfile -Command \"Set-Location 'apps/cosmic-forge-fits-renderer-go'; go test ./...\""
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "powershell -NoProfile -Command \"Get-ChildItem 'apps/cosmic-forge-fits-renderer-go' -Filter *.go | ForEach-Object { gofmt -w $_.FullName }\""
      }
    }
  }
}
