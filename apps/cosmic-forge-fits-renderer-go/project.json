{
  "name": "cosmic-forge-fits-renderer-go",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cosmic-forge-fits-renderer-go",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/cosmic-forge-fits-renderer-go"],
      "options": {
        "cwd": "apps/cosmic-forge-fits-renderer-go",
        "command": "go build -o ../../dist/apps/cosmic-forge-fits-renderer-go/ ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/cosmic-forge-fits-renderer-go",
        "command": "go test ./... -count=1"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/cosmic-forge-fits-renderer-go",
        "command": "go vet ./..."
      }
    }
  }
}
