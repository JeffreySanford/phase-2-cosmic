{
  "name": "cosmic-forge-worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cosmic-forge-worker/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/cosmic-forge-worker"],
      "options": {
        "command": "pnpm exec tsc -p apps/cosmic-forge-worker/tsconfig.app.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./node_modules/tsx/dist/cli.mjs watch --tsconfig apps/cosmic-forge-worker/tsconfig.app.json apps/cosmic-forge-worker/src/main.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./node_modules/tsx/dist/cli.mjs --tsconfig apps/cosmic-forge-worker/tsconfig.app.json --test apps/cosmic-forge-worker/src/main.spec.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/cosmic-forge-worker/src/**/*.ts"]
      }
    }
  }
}
