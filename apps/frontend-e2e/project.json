{
  "name": "frontend-e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/frontend-e2e/src",
  "tags": [],
  "implicitDependencies": ["frontend"],
  "// targets": "to see all targets run: nx show project frontend-e2e --web",
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/frontend-e2e/**/*.ts"]
      }
    }
    ,"e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend-e2e",
        "command": "cypress run"
      },
      "cache": true,
      "inputs": ["default","^default"],
      "outputs": ["{workspaceRoot}/dist/cypress/apps/frontend-e2e/videos","{workspaceRoot}/dist/cypress/apps/frontend-e2e/screenshots"],
      "parallelism": false,
      "metadata": {"technologies": ["cypress"], "description": "Runs Cypress Tests"}
    },
    "e2e-ci": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend-e2e",
        "command": "cypress run --env webServerCommand=\"pnpm exec nx run frontend:serve-static\" --config=\"{\\\"baseUrl\\\":\\\"http://localhost:4200\\\"}\""
      },
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": [
        "{workspaceRoot}/dist/cypress/apps/frontend-e2e/videos",
        "{workspaceRoot}/dist/cypress/apps/frontend-e2e/screenshots"
      ],
      "parallelism": false,
      "metadata": { "technologies": ["cypress"], "description": "Runs Cypress Tests in CI mode" }
    }
    ,
    "playwright-ci": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "./",
        "command": "pnpm run playwright:install && pnpm run e2e:playwright"
      },
      "cache": true,
      "inputs": ["default","^default"],
      "outputs": ["{workspaceRoot}/playwright-report"],
      "parallelism": false,
      "metadata": { "technologies": ["playwright"], "description": "Runs Playwright E2E tests in CI mode" }
    }
  }
}
