{
  "name": "ui-theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-theme/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "node ./scripts/run-jest.cjs --config libs/ui-theme/jest.config.cjs"
      },
      "configurations": {
        "ci": {
          "command": "node ./scripts/run-jest.cjs --config libs/ui-theme/jest.config.cjs --ci --forceExit --collectCoverage --coverageReporters=json-summary --coverageReporters=text --coverageDirectory=coverage/libs/ui-theme"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/ui-theme/**/*.ts"]
      }
    }
  }
}
